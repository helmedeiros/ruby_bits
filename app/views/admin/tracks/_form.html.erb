<%= form_for [:admin, @track] do |f| %>
  <% if @track.errors.any? %>
    <div class="errors"><%= @track.errors.full_messages.join('; ') %></div>
  <% end %>
  <p><%= f.label :name %><br><%= f.text_field :name %></p>
  <p><%= f.label :slug %><br><%= f.text_field :slug %></p>
  <p><%= f.label :description %><br><%= f.text_area :description, rows: 4 %></p>
  <p><%= f.label :position %><br><%= f.number_field :position %></p>
  <p><%= f.submit "» save" %></p>
<% end %>
