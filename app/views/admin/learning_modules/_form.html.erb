<%= form_for [:admin, @track, @module], url: form_url do |f| %>
  <p><%= f.label :name %><br><%= f.text_field :name %></p>
  <p><%= f.label :slug %><br><%= f.text_field :slug %></p>
  <p><%= f.label :overview %><br><%= f.text_area :overview, rows: 6 %></p>
  <p><%= f.label :position %><br><%= f.number_field :position %></p>
  <p><%= f.submit "» save" %></p>
<% end %>
