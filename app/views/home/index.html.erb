<% content_for :title, "boot" %>
<section class="boot-log">
  <p class="prompt">whoami</p>
  <pre>>> <%= user_signed_in? ? current_user.nickname : 'guest' %>@rubybits</pre>
  <p class="prompt">cat /etc/motd</p>
  <pre class="motd">
   ______        __         ___  _ __
  / __  /__ __  / /_  __ __/ _ )(_) /____
 / /_/ // // / / __ \/ // / _  / / __(_-<
/_,___/ \_, / /_/_/\_\\_, /____/_/\__/___/
       /___/         /___/
                                  v0.1.0
  </pre>
  <p class="prompt">./start_learning.sh</p>
  <p><%= t('app.tagline') %><span class="cursor"></span></p>

  <hr>
  <h2>pick a track</h2>
  <ul class="tree">
    <% Track.order(:position).limit(6).each do |t| %>
      <li><%= link_to t.name, track_path(t) %> <span class="meta">— <%= t.description %></span></li>
    <% end %>
  </ul>
</section>
