<% content_for :title, @lesson.slug %>
<article class="lesson">
  <nav class="crumbs">
    <%= link_to @track.name, track_path(@track) %> /
    <%= link_to @module.name, track_module_path(@track, @module) %> /
    <span><%= @lesson.title %></span>
  </nav>
  <h1><%= @lesson.title %></h1>
  <div class="body markdown"><%= markdown(@lesson.body) %></div>

  <% if @lesson.activities.any? %>
    <hr>
    <h2>activities</h2>
    <% @lesson.activities.each do |activity| %>
      <%= render 'activities/activity', activity: activity %>
    <% end %>
  <% end %>

  <%= render 'navigation', lesson: @lesson %>
</article>
