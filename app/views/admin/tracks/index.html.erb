<p class="prompt">ls /admin/tracks</p>
<%= link_to "[+ new track]", new_admin_track_path, class: 'btn' %>
<table class="grid">
  <tr><th>slug</th><th>name</th><th>position</th><th>modules</th><th></th></tr>
  <% @tracks.each do |t| %>
    <tr>
      <td><%= link_to t.slug, admin_track_path(t) %></td>
      <td><%= t.name %></td>
      <td><%= t.position %></td>
      <td><%= t.modules.count %></td>
      <td>
        <%= link_to "edit", edit_admin_track_path(t) %> |
        <%= link_to "drop", admin_track_path(t), method: :delete, data: { confirm: "delete #{t.slug}?" } %>
      </td>
    </tr>
  <% end %>
</table>
