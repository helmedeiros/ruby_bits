<% content_for :title, "~#{@user.nickname}" %>
<article class="profile">
  <p class="prompt">finger <%= @user.nickname %></p>
  <pre>
Login        : <%= @user.nickname %>
Email        : <%= @user.email %>
Joined       : <%= @user.created_at.strftime('%Y-%m-%d') %>
Solved       : <%= @passed_count %>
Current strk : <%= @user.current_streak %> days
Longest strk : <%= @user.longest_streak %> days
  </pre>

  <% if @user.awards.any? %>
    <h2>badges</h2>
    <ul class="badges">
      <% @user.awards.includes(:badge).each do |a| %>
        <li title="<%= a.badge.description %>">
          <span class="glyph">[<%= a.badge.icon_glyph %>]</span> <%= a.badge.name %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h2>recent submissions</h2>
  <ul class="tree">
    <% @submissions.each do |s| %>
      <li>
        <span class="meta">[<%= s.status %>]</span>
        <%= link_to s.activity.title, track_module_lesson_path(s.activity.lesson.learning_module.track, s.activity.lesson.learning_module, s.activity.lesson) %>
        <span class="meta"><%= s.created_at.strftime('%Y-%m-%d %H:%M') %></span>
      </li>
    <% end %>
  </ul>
</article>
