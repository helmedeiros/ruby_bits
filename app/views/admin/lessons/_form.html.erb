<%= form_for [:admin, @module.track, @module, @lesson], url: form_url do |f| %>
  <p><%= f.label :title %><br><%= f.text_field :title %></p>
  <p><%= f.label :slug %><br><%= f.text_field :slug %></p>
  <p>
    <%= f.label :body, 'body (markdown)' %><br>
    <%= f.text_area :body, rows: 16, class: 'md-editor', data: { mode: 'markdown' } %>
  </p>
  <p><%= f.label :position %><br><%= f.number_field :position %></p>
  <p><%= f.submit "» save" %></p>
<% end %>
